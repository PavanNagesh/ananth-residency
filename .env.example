# ---- Database (Postgres) ---------------------------------------------------
# Production: Neon pooled connection string from the Vercel integration.
DATABASE_URL=postgres://postgres@localhost:5432/ananth

# ---- Sessions --------------------------------------------------------------
# Long random string. Generate with: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=replace-with-a-long-random-string

# ---- First owner account (created by `bun run db:seed` when no staff exist) --
OWNER_NAME=Owner
OWNER_PHONE=9000000000
OWNER_PASSWORD=replace-me-before-seeding

# ---- Firebase phone sign-in -------------------------------------------------
# Server: project ID used to verify ID tokens.
FIREBASE_PROJECT_ID=
# Browser: web app config from Firebase console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development only: accept the code 123456 for any number when Firebase
# is not configured. Ignored on Vercel production deployments.
DEV_OTP=true

# ---- Razorpay (optional; online payment stays hidden until set) -------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
